#!/usr/bin/env python3
"""The machine's front door.

The container reaches the page through exactly one thing: the emulated serial
console, which is a single byte stream. The harness needs more than one thing
on it — an interactive terminal the user types into, and the commands the agent
runs, at the same time, without either seeing the other's bytes.

So this is a multiplexer, in the sense `ssh` means it: channels over one
connection. It runs as the container's first process, owns the console, and
speaks a framed protocol to the page:

    <verb> <channel> <length>\\n<length bytes>

The console is not eight-bit clean and cannot be made so from in here. runc
gives this process a pseudoterminal, and the bytes it writes are copied by the
init outside the container onto the virtual machine's own console, which is a
tty in cooked mode: on the way out it turns \\n into \\r\\n, and on the way in it
reads ^C as an interrupt and ^S as "stop sending". Neither of those ttys is
reachable from inside the container — the device cgroup refuses to open them.

So the payload is escaped instead. Eleven bytes get a two-byte form, chosen so
that what crosses the console is a stream nothing in between has an opinion
about, and so that both ends can do the work with whole-buffer substitutions
rather than a loop over bytes. The length in the header counts escaped bytes,
so a reader knows exactly how much to take without interpreting any of it.

Two kinds of channel:

- `pty` — a real pseudoterminal with a login shell on it. The user's terminal
  attaches here, which is why full-screen programs, line editing, job control,
  and ^C all work: the guest's own tty driver is doing them, not a JavaScript
  approximation.
- `exec` — a script run by bash with its output collected. stdout and stderr
  stay apart, which a shared console could not do, and each channel reports its
  own exit status.

Verbs from the page: `open`, `data`, `eof`, `signal`, `resize`, `close`.
Verbs to the page: `ready`, `data`, `err`, `exit`, `fatal`.
"""

import errno
import fcntl
import json
import os
import pty
import select
import signal
import struct
import sys
import termios
import tty

# The console. Taken as raw file descriptors because everything here is byte
# work, and Python's text layer would helpfully corrupt it.
CONSOLE_IN = 0
CONSOLE_OUT = 1

# How much to lift off a channel in one read. Larger than a terminal write and
# smaller than a pipe buffer, so a chatty build does not turn into a frame per
# line.
CHUNK = 16384

# The byte that introduces an escape, and the bytes that need one.
#
# `^A` because the emulator itself takes it as its monitor escape and it never
# reaches the guest at all; `\n` because the console inserts a carriage return
# before it; `^C`, `^\` and `^Z` because ISIG turns them into signals; `^Q` and
# `^S` because IXON turns them into flow control; `\r` because ICRNL turns it
# into `\n`; `^D` and `^V` because they are what ICANON would take, and nothing
# here depends on ICANON staying off.
ESCAPE = 0x5C
SPECIAL = (0x01, 0x03, 0x04, 0x0A, 0x0D, 0x11, 0x13, 0x16, 0x1A, 0x1C)

# Escaped as `ESCAPE, byte | 0x80`. The high bit keeps every second byte clear
# of the escape byte itself, so each `ESCAPE` in the stream is unambiguously the
# start of a pair and the substitutions below cannot match across one.
_PAIRS = [(bytes([b]), bytes([ESCAPE, b | 0x80])) for b in (ESCAPE,) + SPECIAL]


def encode(data):
    """Make a payload safe to put on the console."""
    for plain, escaped in _PAIRS:
        data = data.replace(plain, escaped)
    return data


def decode(data):
    """Undo `encode`. The escape byte is restored last, for the same reason it is escaped first."""
    for plain, escaped in reversed(_PAIRS):
        data = data.replace(escaped, plain)
    return data


def write_all(fd, data):
    """Write every byte, retrying the short writes a serial console produces."""
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except OSError as error:
            if error.errno in (errno.EAGAIN, errno.EINTR):
                select.select([], [fd], [])
                continue
            raise
        view = view[written:]


def send(verb, channel, payload=b""):
    """Emit one frame to the page."""
    body = encode(payload)
    write_all(CONSOLE_OUT, b"%s %d %d\n" % (verb, channel, len(body)))
    if body:
        write_all(CONSOLE_OUT, body)


class Channel:
    """One conversation: a process, the descriptors it talks through, its state."""

    def __init__(self, number, pid, stdin_fd, outputs):
        self.number = number
        self.pid = pid
        self.stdin_fd = stdin_fd
        # fd → the verb its bytes are reported under, so an `exec` channel can
        # keep stderr distinguishable while a `pty` has only the one stream.
        self.outputs = outputs
        self.exited = None
        self.reported = False

    def open_outputs(self):
        return [fd for fd in self.outputs if fd is not None]

    def finish(self):
        """Report the exit, once both the status and the last output are in."""
        if self.reported or self.exited is None or self.open_outputs():
            return False
        self.reported = True
        send(b"exit", self.number, str(self.exited).encode())
        if self.stdin_fd is not None:
            close_quietly(self.stdin_fd)
            self.stdin_fd = None
        return True


def close_quietly(fd):
    try:
        os.close(fd)
    except OSError:
        pass


def set_nonblocking(fd):
    flags = fcntl.fcntl(fd, fcntl.F_GETFL)
    fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)


def environment(extra):
    """The environment a channel's process runs with."""
    env = dict(os.environ)
    for name, value in (extra or {}).items():
        if value is None:
            env.pop(name, None)
        else:
            env[name] = str(value)
    return env


def spawn_pty(request):
    """Start a login shell on a pseudoterminal."""
    pid, master = pty.fork()
    if pid == 0:
        # Child. Nothing here may raise past the exec: a returning child would
        # become a second multiplexer writing to the same console.
        try:
            os.chdir(request.get("cwd") or os.environ.get("HOME", "/"))
        except OSError:
            pass
        os.environ.update({k: str(v) for k, v in (request.get("env") or {}).items() if v is not None})
        os.environ.setdefault("TERM", "xterm-256color")
        shell = request.get("shell") or "/bin/bash"
        # `-l` by default because that is how dsh starts a shell on a machine,
        # and a login shell is where /etc/profile.d puts the toolchain on PATH.
        argv = [str(a) for a in request.get("argv") or []] or [shell, "-l"]
        try:
            os.execv(shell, argv)
        except OSError:
            os._exit(127)
    resize_pty(master, request.get("cols", 80), request.get("rows", 24))
    set_nonblocking(master)
    return Channel(request["channel"], pid, master, {master: b"data"})


def resize_pty(fd, cols, rows):
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", int(rows), int(cols), 0, 0))
    except OSError:
        pass


def spawn_exec(request):
    """Run a script under bash, with its three streams as pipes."""
    script = request.get("script", "")
    # Written to a file rather than passed as `bash -c <script>`: an argument
    # travels through this process's argv and the kernel's, and a file's bytes
    # are the bytes the agent wrote.
    path = "/tmp/.dsh/run-%d.sh" % request["channel"]
    os.makedirs("/tmp/.dsh", exist_ok=True)
    with open(path, "w") as handle:
        handle.write(script)

    stdin_r, stdin_w = os.pipe()
    stdout_r, stdout_w = os.pipe()
    stderr_r, stderr_w = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.dup2(stdin_r, 0)
            os.dup2(stdout_w, 1)
            os.dup2(stderr_w, 2)
            for fd in (stdin_r, stdin_w, stdout_r, stdout_w, stderr_r, stderr_w):
                close_quietly(fd)
            # Its own process group, so a signal aimed at the channel reaches
            # the whole tree the script started rather than only bash.
            os.setsid()
            try:
                os.chdir(request.get("cwd") or os.environ.get("HOME", "/"))
            except OSError:
                pass
            env = environment(request.get("env"))
            # `-l` because that is how dsh spawns a shell on a machine, and a
            # login shell is where /etc/profile.d puts the toolchain on PATH.
            argv = ["/bin/bash", "-l"]
            args = [str(a) for a in request.get("args") or []]
            if args:
                # POSIX puts the name after the script in `sh -c script name
                # arg…`, so `$0` is that name. bash running a script by path
                # makes `$0` the path instead, so the script is sourced and the
                # positional parameters come from this argv — which is where
                # they belong.
                env["DSH_SCRIPT"] = path
                argv += ["-c", 'source "$DSH_SCRIPT"'] + args
            else:
                argv += [path]
            os.execve("/bin/bash", argv, env)
        except BaseException:
            os._exit(127)
    for fd in (stdin_r, stdout_w, stderr_w):
        close_quietly(fd)
    set_nonblocking(stdout_r)
    set_nonblocking(stderr_r)
    return Channel(request["channel"], pid, stdin_w, {stdout_r: b"data", stderr_r: b"err"})


class Reader:
    """The page's half of the console, reassembled into frames."""

    def __init__(self):
        self.buffer = bytearray()
        self.header = None

    def feed(self, data):
        self.buffer.extend(data)
        while True:
            if self.header is None:
                end = self.buffer.find(b"\n")
                if end < 0:
                    return
                parts = bytes(self.buffer[:end]).split()
                del self.buffer[: end + 1]
                if len(parts) != 3:
                    continue
                self.header = (parts[0], int(parts[1]), int(parts[2]))
            verb, channel, length = self.header
            if len(self.buffer) < length:
                return
            payload = decode(bytes(self.buffer[:length]))
            del self.buffer[:length]
            self.header = None
            yield verb, channel, payload


SIGNALS = {
    "SIGINT": signal.SIGINT,
    "SIGTERM": signal.SIGTERM,
    "SIGKILL": signal.SIGKILL,
    "SIGHUP": signal.SIGHUP,
    "SIGQUIT": signal.SIGQUIT,
}


def main():
    # Raw on this end of the pipe. It is not the tty that mangles the frames —
    # that one is outside the container — but it is one fewer line discipline
    # between here and the page, and it costs nothing to say so.
    try:
        tty.setraw(CONSOLE_IN)
    except (termios.error, OSError):
        pass
    set_nonblocking(CONSOLE_IN)

    # Reaped explicitly below; the default disposition would leave zombies
    # whose exit status the channel needs.
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)

    channels = {}
    reader = Reader()
    send(b"ready", 0)

    while True:
        watched = [CONSOLE_IN]
        for channel in channels.values():
            watched.extend(channel.open_outputs())
        try:
            readable, _, _ = select.select(watched, [], [], 0.2)
        except (OSError, select.error) as error:
            if getattr(error, "errno", None) == errno.EINTR:
                continue
            raise

        if CONSOLE_IN in readable:
            try:
                data = os.read(CONSOLE_IN, CHUNK)
            except OSError as error:
                data = b"" if error.errno not in (errno.EAGAIN, errno.EINTR) else None
            if data == b"":
                break
            if data:
                for verb, number, payload in reader.feed(data):
                    handle(channels, verb, number, payload)

        for channel in list(channels.values()):
            for fd in list(channel.outputs):
                if fd not in readable:
                    continue
                try:
                    data = os.read(fd, CHUNK)
                except OSError as error:
                    # A pty's master reports EIO when the last slave closes,
                    # which is how a shell exiting looks from here.
                    data = b"" if error.errno in (errno.EIO,) else None
                    if error.errno in (errno.EAGAIN, errno.EINTR):
                        continue
                if data:
                    send(channel.outputs[fd], channel.number, data)
                elif data == b"":
                    close_quietly(fd)
                    del channel.outputs[fd]

        reap(channels)
        for channel in list(channels.values()):
            if channel.finish():
                del channels[channel.number]


def reap(channels):
    """Collect exit statuses without blocking."""
    while True:
        try:
            pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        if pid == 0:
            return
        for channel in channels.values():
            if channel.pid != pid:
                continue
            if os.WIFSIGNALED(status):
                channel.exited = 128 + os.WTERMSIG(status)
            else:
                channel.exited = os.WEXITSTATUS(status)


def handle(channels, verb, number, payload):
    """Act on one frame from the page."""
    if verb == b"open":
        request = json.loads(payload.decode() or "{}")
        request["channel"] = number
        try:
            channel = spawn_pty(request) if request.get("kind") == "pty" else spawn_exec(request)
        except Exception as error:  # noqa: BLE001 - reported, never fatal
            send(b"err", number, ("dsh-mux: %s\n" % error).encode())
            send(b"exit", number, b"127")
            return
        channels[number] = channel
        return

    channel = channels.get(number)
    if channel is None:
        return
    if verb == b"data":
        if channel.stdin_fd is not None:
            try:
                write_all(channel.stdin_fd, payload)
            except OSError:
                pass
    elif verb == b"eof":
        if channel.stdin_fd is not None and channel.number in channels:
            # A pty has one descriptor for both directions; closing it would
            # take the output with it, so only a pipe is closed here.
            if len(channel.outputs) != 1 or channel.stdin_fd not in channel.outputs:
                close_quietly(channel.stdin_fd)
                channel.stdin_fd = None
    elif verb == b"resize":
        cols, _, rows = payload.decode().partition(" ")
        resize_pty(channel.stdin_fd, cols or 80, rows or 24)
    elif verb == b"signal":
        number_or_name = payload.decode().strip() or "SIGTERM"
        signum = SIGNALS.get(number_or_name, signal.SIGTERM)
        try:
            # Negative pid: the group, so a `sleep 100 | cat` dies whole.
            os.killpg(channel.pid, signum)
        except OSError:
            try:
                os.kill(channel.pid, signum)
            except OSError:
                pass
    elif verb == b"close":
        try:
            os.killpg(channel.pid, signal.SIGKILL)
        except OSError:
            pass


if __name__ == "__main__":
    try:
        main()
    except Exception as error:  # noqa: BLE001 - the page has to hear about it
        try:
            send(b"fatal", 0, str(error).encode())
        except Exception:  # noqa: BLE001
            pass
        raise
